# ==============================================================================
# WanderWise AI — Unified Environment Configuration Reference
# ==============================================================================

# --- Frontend (.env in frontend/) ---
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
VITE_GITHUB_REPO_URL=https://github.com/your-username/wanderwise-ai
VITE_DEMO_VIDEO_URL=https://www.youtube.com/watch?v=your-demo-video-id

# --- Backend (.env in backend/) ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Generative AI API Keys (Server-side only — never exposed to client)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=

# Supabase Server-side (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
